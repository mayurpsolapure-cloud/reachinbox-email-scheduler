# Copy this file to .env and replace the placeholders before starting services.
# Keep POSTGRES_PASSWORD consistent with the password in DATABASE_URL.
NODE_ENV=development
PORT=5000

# Local PostgreSQL values match docker-compose.yml.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://postgres:change-this-local-password@127.0.0.1:5432/reachinbox

# Redis is started by docker-compose.yml.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch is started by docker-compose.yml; search is unavailable if it is down.
ELASTICSEARCH_URL=http://127.0.0.1:9200

# Required for Google OAuth and the PostgreSQL-backed Express session.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters

# Rate limiting. Defaults are 100 emails per sender per hour and a 2 second minimum gap.
MAX_EMAILS_PER_SENDER_PER_HOUR=100
SENDER_RATE_LIMIT_WINDOW_MS=3600000
MIN_EMAIL_DELAY_MS=2000

# Optional bounded worker concurrency settings.
WORKER_CONCURRENCY=2
SLACK_WORKER_CONCURRENCY=2

# Optional HTTP Basic Auth for /admin/queues. Leave blank to keep that UI inaccessible.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# Optional Slack incoming-webhook integration. Required only when connecting Slack.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SLACK_WEBHOOK_ENCRYPTION_KEY=
