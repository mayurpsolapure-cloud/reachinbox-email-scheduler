{
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "@elastic/elasticsearch": "^9.5.1",
    "bullmq": "^6.7.1",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.3",
    "googleapis": "^189.0.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --import tsx --test scripts/auth.routes.test.ts",
    "test:cors": "node --import tsx --test scripts/api-cors.test.ts",
    "test:gmail": "node --import tsx --test scripts/gmail.api.test.ts",
    "test:gmail:db": "node --env-file=.env --import tsx --test scripts/gmail.db.integration.test.ts",
    "test:auth:db": "node --env-file=.env --import tsx --test scripts/auth.db.integration.test.ts",
    "test:auth:api": "node --env-file=.env --import tsx --test scripts/auth.api.integration.test.ts",
    "test:slack": "node --import tsx --test scripts/slack.routes.test.ts",
    "test:slack:db": "node --env-file=.env --import tsx --test scripts/slack.db.integration.test.ts",
    "test:rate-limiter": "node --env-file=.env --import tsx --test scripts/rate-limiter.integration.test.ts",
    "test:api-rate-limit": "node --env-file=.env --import tsx --test scripts/api-rate-limit.test.ts",
    "test:scheduler:bulk": "node --env-file=.env --import tsx --test scripts/scheduler.bulk.integration.test.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:migrate": "node --env-file-if-exists=.env dist/db/migrate.js && node --env-file-if-exists=.env dist/server.js",
    "worker:start": "node --env-file-if-exists=.env dist/workers/email.worker.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:migrate:compiled": "node --env-file-if-exists=.env dist/db/migrate.js",
    "worker": "node --env-file-if-exists=.env --import tsx src/workers/email.worker.ts"
  }
}
